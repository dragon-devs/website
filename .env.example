# ─── Contact form email (nodemailer over SMTP) ──────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# The contact form (/api/contact) sends you an email when someone submits it.

# Where enquiries are delivered (your inbox):
CONTACT_TO=info@dragondevs.co
# What address the email is sent "from" (often the same as SMTP_USER):
CONTACT_FROM=info@dragondevs.co

# ── Option A: Mailgun SMTP ──
# Get these from Mailgun → Sending → Domain settings → SMTP credentials.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.dragondevs.co
SMTP_PASS=your-mailgun-smtp-password

# ── Option B: Gmail (use an App Password, not your normal password) ──
# Create one at https://myaccount.google.com/apppasswords (requires 2FA).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-16-char-app-password
